# XILEF Mini Backend - Variables de Entorno
# Copiar a .env y completar los valores

# ── Base de datos ─────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/xilefmini

# ── Puerto del servidor (opcional, default: 3000) ─────
PORT=3000

# ── Auth JWT ──────────────────────────────────────────
# Debe coincidir entre instancias. Si no se define, se usa el
# fallback interno ('Chimuelo' / '1h') para no romper en dev.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# ── Licencias (Ed25519 verify-only) ───────────────────
# Override opcional de la clave pública (base64 32 bytes).
# Si no se define, se usa la constante del código.
# LICENCIA_ED25519_PUBLIC_KEY=

# ── Ruta del archivo de licencia offline (.lic) ───────
# LICENSE_FILE_PATH=./license.lic
